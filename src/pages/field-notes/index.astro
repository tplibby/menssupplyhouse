---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../data/blog';
const posts = await getPosts();
const feature = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== feature);
---
<Base title="Field Notes" description="Guides, comparisons, test updates and what I carry. Written from gear I've used.">
  <section class="mx-auto max-w-7xl px-4 pt-10">
    <p class="eyebrow text-brick">Field Notes</p>
    <h1 class="display mt-2 max-w-3xl text-[64px] sm:text-[96px]">Notes from the bench.</h1>
    <p class="mt-3 max-w-xl text-[17px] text-ink/80">Guides, comparisons, test updates and what I'm carrying. Same rule as the reviews: only gear I've actually used.</p>
  </section>

  {feature ? (
    <>
      <section class="mx-auto mt-10 max-w-7xl px-4"><PostCard post={feature} size="feature" /></section>
      {rest.length > 0 && (
        <section aria-labelledby="all-h" class="mx-auto mt-14 max-w-5xl px-4">
          <h2 id="all-h" class="display text-4xl">All notes</h2>
          <ul class="mt-2 divide-y divide-line border-y border-line">{rest.map((p) => <li><PostCard post={p} /></li>)}</ul>
        </section>
      )}
    </>
  ) : (
    <section class="mx-auto mt-10 max-w-7xl px-4"><div class="rounded-[14px] bg-paper p-8"><p class="display text-3xl">First note coming soon.</p></div></section>
  )}
</Base>

---
import Base from '../layouts/Base.astro';
import BrandImage from '../components/BrandImage.astro';
import CategoryRail from '../components/CategoryRail.astro';
import CounterCall from '../components/CounterCall.astro';
import { categories, items, itemHref, type Category } from '../data/site';
export function getStaticPaths() { return categories.map((c) => ({ params: { category: c.slug }, props: { c } })); }
const { c } = Astro.props as { c: Category };
const row = items.filter((i) => i.category === c.slug);
---
<Base title={`${c.name} reviews`} description={`${c.name} I bought and used until it showed wear. ${c.notes}`}>
  <section class="mx-auto max-w-7xl px-4 pt-4">
    <div class="relative overflow-hidden rounded-[14px]">
      <BrandImage src={c.image} alt="" eager class="h-[300px] sm:h-[420px]" />
      <div class="absolute inset-0 bg-gradient-to-t from-night/90 via-night/55 to-night/10 sm:from-night/80 sm:via-night/25 sm:to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 p-6 text-paper sm:p-10">
        <p class="eyebrow text-paper/75">{row.length} tested</p>
        <h1 class="display mt-2 text-[64px] sm:text-[96px]">{c.name}</h1>
        <p class="mt-2 max-w-md text-[17px] text-paper/85">{c.notes}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="list-h" class="mx-auto mt-12 max-w-7xl px-4">
    <h2 id="list-h" class="display text-4xl">Every {c.name.toLowerCase()} review</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {row.map((i) => {
        const href = itemHref(i); const Tag = href ? 'a' : 'div';
        return (
          <li>
            <Tag href={href} class="group block">
              <div class="ph grid aspect-[4/3] place-items-center rounded-[14px] p-4 text-center text-xs">[REAL PHOTO: {i.name}]</div>
              <div class="mt-3 flex items-start justify-between gap-3">
                <div>
                  <p class="eyebrow text-muted">{i.days} days{i.sample && ' · sample'}</p>
                  <p class="display mt-1 text-3xl group-hover:text-brick">{i.name}</p>
                </div>
                <CounterCall verdict={i.verdict} />
              </div>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>

  <section aria-labelledby="more-h" class="mx-auto mt-16 max-w-7xl px-4">
    <h2 id="more-h" class="eyebrow text-brick">Other categories</h2>
    <div class="mt-4"><CategoryRail current={c.slug} /></div>
  </section>
</Base>

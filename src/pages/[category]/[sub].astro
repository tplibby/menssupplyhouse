---
import CategoryView from '../../components/CategoryView.astro';
import { categories, type Category, type Sub } from '../../data/site';
export function getStaticPaths() {
  return categories.flatMap((c) => c.subs.map((s) => ({ params: { category: c.slug, sub: s.slug }, props: { c, sub: s } })));
}
const { c, sub } = Astro.props as { c: Category; sub: Sub };
---
<CategoryView c={c} sub={sub} />

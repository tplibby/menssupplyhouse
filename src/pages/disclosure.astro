---
import Base from '../layouts/Base.astro';
---
<Base title="Affiliate disclosure">
  <div class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="display text-[56px] sm:text-[72px]">Affiliate disclosure</h1>
    <div class="mt-6 grid gap-4 text-[18px] leading-relaxed">
      <p>Some links on this site go to retailers like Amazon. If you buy through them, I may earn a commission. You pay the same price.</p>
      <p>Every review says how I got the product: bought, sent free by the brand, or on loan. Brands don't see reviews before they go up and don't get a say in the call. Commissions don't change it either.</p>
      <p class="text-sm text-muted">[VERIFY: final wording against the spec and each affiliate program's required language]</p>
    </div>
  </div>
</Base>

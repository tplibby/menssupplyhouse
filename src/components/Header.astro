---
import { categories } from '../data/site';
const current = Astro.url.pathname.split('/')[1];
---
<div class="bg-night text-paper">
  <p class="mx-auto max-w-7xl px-4 py-2 text-center text-[11px] font-semibold uppercase tracking-[.12em]">Every product bought with my own money</p>
</div>
<header class="sticky top-0 z-30 border-b border-line bg-stone/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2">
    <a href="/" class="display flex min-h-11 items-center text-[28px] sm:text-[32px]">Men&rsquo;s Supply House</a>
    <nav aria-label="Site" class="flex items-center gap-1 text-[12px] font-semibold uppercase tracking-[.08em]">
      <a href="/how-we-test/" class="flex min-h-11 items-center px-2 hover:text-brick">How we test</a>
      <a href="/about/" class="hidden min-h-11 items-center px-2 hover:text-brick sm:flex">About</a>
    </nav>
  </div>
  <nav aria-label="Categories" class="border-t border-line">
    <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-2 [scrollbar-width:none] lg:justify-center">
      {categories.map((c) => (
        <li><a href={`/${c.slug}/`} aria-current={current === c.slug ? 'page' : undefined}
          class="flex min-h-11 items-center whitespace-nowrap px-3 text-[12px] font-semibold uppercase tracking-[.08em] hover:text-brick aria-[current=page]:text-brick">{c.name}</a></li>
      ))}
    </ul>
  </nav>
</header>

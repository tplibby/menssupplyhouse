---
// Shared body for category pages (/cat/) and subcategory pages (/cat/sub/).
import Base from '../layouts/Base.astro';
import BrandImage from './BrandImage.astro';
import CategoryRail from './CategoryRail.astro';
import CounterCall from './CounterCall.astro';
import { items, itemHref, type Category, type Sub } from '../data/site';
interface Props { c: Category; sub?: Sub }
const { c, sub } = Astro.props;
const row = items.filter((i) => i.category === c.slug && (!sub || i.sub === sub.slug));
const title = sub ? sub.name : c.name;
const count = (s?: Sub) => items.filter((i) => i.category === c.slug && (!s || i.sub === s.slug)).length;
const chip = 'pill whitespace-nowrap ring-1 ring-line bg-paper hover:bg-olive hover:text-paper aria-[current=page]:bg-olive aria-[current=page]:text-paper aria-[current=page]:ring-olive';
---
<Base title={`${sub ? `${sub.name} (${c.name})` : c.name} reviews`} description={`${title} I bought and used until it showed wear. ${c.notes}`}>
  <section class="mx-auto max-w-7xl px-4 pt-4">
    <div class="relative overflow-hidden rounded-[14px]">
      <BrandImage src={c.image} alt="" eager class="h-[300px] sm:h-[420px]" />
      <div class="absolute inset-0 bg-gradient-to-t from-night/90 via-night/55 to-night/10 sm:from-night/80 sm:via-night/25 sm:to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 p-6 text-paper sm:p-10">
        {sub
          ? <a href={`/${c.slug}/`} class="eyebrow inline-flex min-h-11 items-center text-paper/80 hover:text-paper">{c.name} &rsaquo;</a>
          : <p class="eyebrow text-paper/75">{row.length} tested</p>}
        <h1 class="display mt-1 text-[64px] sm:text-[96px]">{title}</h1>
        <p class="mt-2 max-w-md text-[17px] text-paper/85">{sub ? `${row.length} tested.` : ''} {c.notes}</p>
      </div>
    </div>
  </section>

  {c.subs.length > 0 && (
    <nav aria-label={`${c.name} sections`} class="mx-auto mt-6 max-w-7xl px-4">
      <ul class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
        <li><a href={`/${c.slug}/`} aria-current={!sub ? 'page' : undefined} class={chip}>All {c.name} <span class="opacity-60">{count()}</span></a></li>
        {c.subs.map((s) => (
          <li><a href={`/${c.slug}/${s.slug}/`} aria-current={sub?.slug === s.slug ? 'page' : undefined} class={chip}>{s.name} <span class="opacity-60">{count(s)}</span></a></li>
        ))}
      </ul>
    </nav>
  )}

  <section aria-labelledby="list-h" class="mx-auto mt-10 max-w-7xl px-4">
    <h2 id="list-h" class="display text-4xl">Every {title.toLowerCase()} review</h2>
    {row.length === 0 ? (
      <div class="mt-6 rounded-[14px] bg-paper p-8">
        <p class="display text-3xl">Nothing on the clock yet.</p>
        <p class="mt-2 text-muted">The first {title.toLowerCase()} review is being tested. It goes up once it has real days on it.</p>
      </div>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {row.map((i) => {
          const href = itemHref(i); const Tag = href ? 'a' : 'div';
          const s = c.subs.find((x) => x.slug === i.sub);
          return (
            <li>
              <Tag href={href} class="group block">
                <div class="ph grid aspect-[4/3] place-items-center rounded-[14px] p-4 text-center text-xs">[REAL PHOTO: {i.name}]</div>
                <div class="mt-3 flex items-start justify-between gap-3">
                  <div>
                    <p class="eyebrow text-muted">{!sub && s ? `${s.name} · ` : ''}{i.days} days{i.sample && ' · sample'}</p>
                    <p class="display mt-1 text-3xl group-hover:text-brick">{i.name}</p>
                  </div>
                  <CounterCall verdict={i.verdict} />
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <section aria-labelledby="more-h" class="mx-auto mt-16 max-w-7xl px-4">
    <h2 id="more-h" class="eyebrow text-brick">Other categories</h2>
    <div class="mt-4"><CategoryRail current={c.slug} /></div>
  </section>
</Base>
